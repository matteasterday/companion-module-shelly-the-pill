{
	"$schema": "../node_modules/@companion-module/base/assets/manifest.schema.json",
	"type": "connection",
	"id": "shelly-the-pill",
	"name": "shelly-the-pill",
	"shortname": "shelly-pill",
	"description": "Control and monitor The Pill by Shelly (Gen3) — temperature, humidity and other attached sensors, switches, and scripts via the Shelly RPC API",
	"version": "2.1.1",
	"license": "MIT",
	"repository": "git+https://github.com/matteasterday/companion-module-shelly-the-pill.git",
	"bugs": "https://github.com/matteasterday/companion-module-shelly-the-pill/issues",
	"maintainers": [
		{
			"name": "Matthew Easterday",
			"email": "hello@mattheweasterday.com"
		}
	],
	"runtime": {
		"type": "node22",
		"api": "nodejs-ipc",
		"apiVersion": "1.14.1",
		"entrypoint": "../src/main.js"
	},
	"legacyIds": [],
	"manufacturer": "Shelly",
	"products": ["The Pill"],
	"bonjourQueries": {
		"bonjour_host": { "type": "shelly", "protocol": "tcp", "txt": { "app": "Pill" } }
	},
	"keywords": ["shelly", "the pill", "temperature", "humidity", "ds18b20", "sensor", "iot"]
}
